# Copier en .env et remplir pour chaque PC

# Profil Docker Compose :
# - Windows natif : primary (PC A) ou secondary (PC B) — PrintSvc tourne nativement sur Windows
# - Hôte Linux    : ajouter ",print-vm" (ex: primary,print-vm) pour lancer PrintSvc en VM Windows
COMPOSE_PROFILES=primary

# Identifiant de ce stand (doit être unique par PC)
STAND_ID=stand-a

# IP du PC A sur le réseau local (utilisée par MinIO et le frontend)
PRIMARY_IP=192.168.x.x

# Endpoint MinIO
# primary  : minio:9000       (service Docker local)
# secondary: 192.168.x.x:9000  (IP du PC A)
STORAGE_ENDPOINT=minio:9000

# UID/GID de l'utilisateur Linux hôte (pour les permissions sur volumes/capture)
PUID=1000
PGID=1000

# Configuration VM Windows d'impression (profil print-vm, hôte Linux uniquement)
PRINT_VM_WINDOWS_VERSION=10
PRINT_VM_RAM=4G
PRINT_VM_CPUS=2
PRINT_VM_DISK=40G
# USB passthrough QEMU (ex: Fujifilm DX100 = 04cb:5007)
PRINTER_USB_ARGS=-device usb-host,vendorid=0x04cb,productid=0x5007
# Nom de l'imprimante Windows (vide = imprimante par défaut)
PRINTER_NAME=
PAPER_WIDTH_INCHES=6.0
PAPER_HEIGHT_INCHES=4.0
# En mode secondary sur Linux, remplacer par PRIMARY_IP et PRIMARY_IP:9000
PRINT_BROKER_HOST=rabbitmq.stand.local
PRINT_STORAGE_ENDPOINT=minio.stand.local:9000
